#include 'actions/documents'
#include 'actions/web'
#include 'actions/media'
#include 'actions/text'
#define inputs image, pdf, file, text
#define from sharesheet

/* 시작 페이지의 [내 계정 연결] 버튼이 토큰을 텍스트로 넘겨 줌 */
@input = "{ShortcutInput}"
if @input beginsWith "p3_" {
    @cleanInput = trimWhitespace(@input)
    saveFile("pick3_token.txt", @cleanInput, true)
    show("✅ 연결 완료. 이제 화면이나 PDF를 공유하면 저장됩니다.")
    stop()
}

@tokenFile = getFile("pick3_token.txt", nil, false)
if !@tokenFile {
    show("먼저 Pick3 시작 페이지에서 [② 내 계정 연결]을 눌러 주세요.")
    stop()
}
/* 파일 '내용'을 글자로 꺼내고 앞뒤 공백·줄바꿈 제거 */
@tokenText = getText(@tokenFile)
@token = trimWhitespace(@tokenText)

if !ShortcutInput {
    @image = takeScreenshot()
} else {
    @image = ShortcutInput
}

@response = formRequest("https://pick3-api.onrender.com/api/ingest/screenshot", "POST", {"image": "{@image}"}, {"X-Pick3-Token": "{@token}"})
@result = getDictionary(@response)
@message = getValue(@result, "message")
if @message {
    show("{@message}")
} else {
    show("서버 응답: {@response}")
}
